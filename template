const D=JSON.parse(document.getElementById('data').textContent);
let PHOTOS={},LOGOS={};try{PHOTOS=JSON.parse(document.getElementById('photos').textContent)}catch(e){}try{LOGOS=JSON.parse(document.getElementById('logos').textContent)}catch(e){}
const REMOTE=__REMOTE__;
const T=D.teams,P=D.players,G=D.games,R=D.rows;
const CUR=2027,PREV=2026,SEASONS={2027:'2026-27',2026:'2025-26'};
const STATS=[['PTS','Points',r=>r[9]],['REB','Rebounds',r=>r[10]],['AST','Assists',r=>r[11]],['3PM','Threes made',r=>r[15]],['PRA','Pts+Reb+Ast',r=>r[9]+r[10]+r[11]],['P+R','Pts+Reb',r=>r[9]+r[10]],['P+A','Pts+Ast',r=>r[9]+r[11]],['R+A','Reb+Ast',r=>r[10]+r[11]],['STL','Steals',r=>r[12]],['BLK','Blocks',r=>r[13]],['STL+BLK','Stocks',r=>r[12]+r[13]],['TOV','Turnovers',r=>r[14]]];
const SK=STATS.map(s=>s[0]),sf=k=>STATS.find(s=>s[0]===k)[2],sname=k=>STATS.find(s=>s[0]===k)[1];
const posG=p=>{p=(p||'').toUpperCase();return p.includes('C')?'C':p.includes('G')?'G':'F'};
const POSN={G:'Guards',F:'Forwards',C:'Centers',A:'All positions'};
const byP=new Map();R.forEach(r=>{(byP.get(r[1])||byP.set(r[1],[]).get(r[1])).push(r)});
byP.forEach(a=>a.sort((x,y)=>G[x[0]][0]<G[y[0]][0]?-1:G[x[0]][0]>G[y[0]][0]?1:0));
const tA=i=>T[i][0],tN=i=>T[i][1],tS=i=>T[i][2],tC=i=>'#'+T[i][3];
const logo=(t,size=24)=>LOGOS[t]?`<img class="lg" src="${LOGOS[t]}" alt="${esc(T[t][2])}" width="${size}" height="${size}" style="width:${size}px;height:${size}px" loading="lazy" onerror="this.style.visibility='hidden'">`:`<span class="sw" style="background:${tC(t)};height:${size}px"></span>`;
const STATUS=D.status||{},REASONS=D.reasons||[];
const pretty=s=>{s=s.toLowerCase();return s.charAt(0).toUpperCase()+s.slice(1)};
function pstat(i){const x=STATUS[i];if(!x)return null;const r=REASONS[x[1]]||'';const coach=r.includes('COACH');const label=r==='INACTIVE'?'Not playing':coach?"Coach's decision":r==='REST'?'Rest':r.includes('SUSPEND')?'Suspended':'Injury: '+pretty(r.replace('INJURY/ILLNESS - ',''));return{n:x[0],label,coach,short:coach?'DNP':'OUT'}}
const DNP=new Map();(D.dnp||[]).forEach(d=>{(DNP.get(d[1])||DNP.set(d[1],[]).get(d[1])).push(d)});
const dnpLabel=r=>{r=REASONS[r]||'';return r.includes('COACH')?"Coach's decision":r==='DID NOT PLAY'?'Did not play':pretty(r)};
const fmt=(v,d=1)=>v==null||isNaN(v)?'–':v.toFixed(d);
const avg=a=>a.length?a.reduce((s,x)=>s+x,0)/a.length:null;
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const el=h=>{const t=document.createElement('template');t.innerHTML=h.trim();return t.content.firstChild};
const md=d=>{const [y,m,dd]=d.split('-');return +m+'/'+ +dd+'/'+y.slice(2)};
const dl=d=>new Date(d+'T12:00:00').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});

/* ---- defense allowed: season -> team -> pos -> stat -> per game ---- */
const DEF={},RANK={},LG={};
[CUR,PREV].forEach(s=>{
  const tot={},gms={};
  R.forEach(r=>{const g=G[r[0]];if(g[1]!==s||g[2]!==2)return;const o=r[3];
    (gms[o]||(gms[o]=new Set())).add(r[0]);
    const pg=posG(P[r[1]][2]);tot[o]=tot[o]||{A:{},G:{},F:{},C:{}};
    STATS.forEach(([k,,f])=>{const v=f(r);tot[o].A[k]=(tot[o].A[k]||0)+v;tot[o][pg][k]=(tot[o][pg][k]||0)+v});
  });
  DEF[s]={};RANK[s]={};LG[s]={};
  Object.keys(tot).forEach(t=>{DEF[s][t]={};['A','G','F','C'].forEach(p=>{DEF[s][t][p]={};SK.forEach(k=>DEF[s][t][p][k]=(tot[t][p][k]||0)/gms[t].size)})});
  ['A','G','F','C'].forEach(p=>{RANK[s][p]={};LG[s][p]={};SK.forEach(k=>{
    const arr=Object.keys(DEF[s]).map(t=>[t,DEF[s][t][p][k]]).sort((a,b)=>b[1]-a[1]);
    RANK[s][p][k]={};arr.forEach(([t],i)=>RANK[s][p][k][t]=i+1);LG[s][p][k]=avg(arr.map(x=>x[1]));
  })});
});
const NT=T.length;
const rkCls=r=>r<=10?'var(--over)':r<=20?'var(--amber)':'var(--under)';

/* ---- state ---- */
const st={view:'slate',date:null,game:null,pid:null,stat:'PTS',lines:{},under:false,sample:'L10',venue:'all',opp:'all',rtab:'opp',dSeason:CUR,dPos:null,dOpp:null,recent:[],mStat:'PTS'};
try{const s=JSON.parse(localStorage.getItem('lablist')||'{}');if(Array.isArray(s.recent))st.recent=s.recent.filter(i=>P[i]);if(s.stat&&SK.includes(s.stat))st.stat=s.stat}catch(e){}
const save=()=>{try{localStorage.setItem('lablist',JSON.stringify({recent:st.recent,stat:st.stat}))}catch(e){}};

function avatar(i,size=44,badge=true){
  const p=P[i],c=tC(p[1]),src=PHOTOS[i];
  const ini=p[0].split(' ').map(w=>w[0]).filter(Boolean).slice(0,2).join('');
  const ps=pstat(i);
  return `<span class="av${ps?' isout':''}" title="${ps?esc(ps.label):''}" style="width:${size}px;height:${size}px;font-size:${Math.round(size*.38)}px;background:${src?'var(--panel3)':c}">${src?`<img src="${src}" alt="">`:`<span class="ini">${esc(ini)}</span>`}${badge?(LOGOS[p[1]]?`<span class="tb lgb">${logo(p[1],Math.max(14,Math.round(size*.36)))}</span>`:`<span class="tb">${esc(tA(p[1]))}</span>`):''}</span>`;
}
function nextGame(t){const s=D.sched.find(x=>x[2]===t||x[3]===t);if(!s)return null;return{date:s[0],time:s[1],home:s[3]===t,opp:s[3]===t?s[2]:s[3]}}
function lineFor(i,k){const key=i+'|'+k;if(st.lines[key]!=null)return st.lines[key];
  const g=byP.get(i).filter(r=>G[r[0]][1]===CUR);const a=avg((g.length?g:byP.get(i)).map(sf(k)))||0;return Math.max(0.5,Math.floor(a)+0.5)}
const hit=(v,L)=>st.under?v<L:v>L;
const hr=(vals,L)=>vals.length?vals.filter(v=>hit(v,L)).length/vals.length:null;
const cls=h=>h==null?'na':h>=.6?'hi':h>=.4?'mid':'lo';

/* ---- top-level render ---- */
function render(){renderRail();renderTop();const v=document.getElementById('view');v.innerHTML='';
  if(st.view==='player'&&st.pid!=null)renderPlayer(v);else if(st.game)renderMatchup(v);else renderSlate(v);}
function renderRail(){
  const r=document.getElementById('rail');r.innerHTML='';
  const m=el('<button class="menu iconbtn" style="width:100%;height:64px;border-radius:0" aria-label="Games">Lab<br>List</button>');
  m.onclick=()=>{st.view='slate';st.game=null;render()};r.append(m);
  if(st.recent.length)r.append(el('<div class="lbl">Recent</div>'));
  st.recent.forEach(i=>{const b=el(`<button class="rp" aria-current="${st.view==='player'&&st.pid===i}" title="${esc(P[i][0])}">${avatar(i,46,false)}<span>${esc(P[i][0].split(' ').slice(-1)[0])}</span></button>`);b.onclick=()=>openPlayer(i);r.append(b)});
}
function renderTop(){
  const tb=document.getElementById('topbar');tb.innerHTML='';
  if(st.view==='player'&&st.pid!=null){
    const i=st.pid,p=P[i],k=st.stat,all=byP.get(i),cur=all.filter(r=>G[r[0]][1]===CUR);
    const back=el('<button class="iconbtn" aria-label="Back to games">←</button>');back.onclick=()=>{st.view='slate';render()};tb.append(back);
    tb.append(el(avatar(i,60)));
    const ps=pstat(i);
    tb.append(el(`<div class="pname ${ps?'outname':''}">${esc(p[0])}<span class="ppos">${esc(p[2]||'')}</span></div>`));
    tb.append(searchBox());
    const shown=sampleGames(i).map(sf(k));
    const mpg=avg(cur.map(r=>r[8])),stp=cur.length?cur.filter(r=>r[22]).length/cur.length:null;
    tb.append(el(`<div class="hstats"><div><small>SEASON AVG</small><b class="g">${fmt(avg(cur.map(sf(k))))}</b></div><div><small>GRAPH AVG</small><b>${fmt(avg(shown))}</b></div><div><small>AVG MIN</small><b>${fmt(mpg)}${stp!=null?` <span class="gs" style="font-size:18px">(${Math.round(stp*100)}% GS)</span>`:''}</b></div></div>`));
  }else{
    tb.append(el('<div class="pname">Lab List</div>'));
    const nav=el(`<div class="navtabs"><button aria-current="true">Games</button></div>`);tb.append(nav);
    const sb=searchBox();sb.style.marginLeft='auto';tb.append(sb);
    tb.append(el(`<div class="asof">Stats through ${dl(D.asof)}${D.built?' · updated '+esc(D.built):''}</div>`));
  }
}
function searchBox(){
  const s=el('<div class="search"><input type="search" placeholder="Search a player" aria-label="Search a player" autocomplete="off"><div class="sugg" role="listbox"></div></div>');
  const inp=s.querySelector('input'),sg=s.querySelector('.sugg');let hits=[],sel=0;
  const draw=()=>{sg.innerHTML='';hits.forEach((i,k)=>{const b=el(`<button role="option" class="${k===sel?'on':''}">${avatar(i,30,false)}<span class="${pstat(i)?'outname':''}">${esc(P[i][0])}</span><span class="muted" style="margin-left:auto;display:flex;gap:6px;align-items:center">${pstat(i)?'<span class="pill red">'+pstat(i).short+'</span>':''}${logo(P[i][1],18)}${esc(tA(P[i][1]))}</span></button>`);b.onmousedown=e=>{e.preventDefault();openPlayer(i)};sg.append(b)});sg.style.display=hits.length?'block':'none'};
  inp.oninput=()=>{const cl=inp.value.replace(/[^\p{L}\s'.\-]/gu,'');if(cl!==inp.value)inp.value=cl;const q=inp.value.trim().toLowerCase();sel=0;if(!q){hits=[];draw();return}
    hits=P.map((p,i)=>[i,p[0].toLowerCase()]).filter(x=>x[1].includes(q)).sort((a,b)=>(a[1].startsWith(q)?0:1)-(b[1].startsWith(q)?0:1)||byP.get(b[0]).length-byP.get(a[0]).length).slice(0,10).map(x=>x[0]);draw()};
  inp.onkeydown=e=>{if(e.key==='ArrowDown'){sel=Math.min(sel+1,hits.length-1);draw();e.preventDefault()}else if(e.key==='ArrowUp'){sel=Math.max(sel-1,0);draw();e.preventDefault()}else if(e.key==='Enter'&&hits[sel]!=null)openPlayer(hits[sel]);else if(e.key==='Escape'){hits=[];draw()}};
  inp.onblur=()=>setTimeout(()=>sg.style.display='none',120);
  return s;
}
function openPlayer(i,opts={}){
  st.view='player';st.pid=i;st.opp=opts.opp!=null?String(opts.opp):'all';if(opts.stat&&SK.includes(opts.stat))st.stat=opts.stat;
  st.venue='all';st.sample='L10';st.dPos=null;st.dOpp=null;
  st.recent=[i,...st.recent.filter(x=>x!==i)].slice(0,12);save();render();window.scrollTo(0,0);
}

/* ---- slate ---- */
const recC={};
function record(t){if(recC[t])return recC[t];const seen=new Set();let w=0,l=0;R.forEach(r=>{if(r[2]===t&&G[r[0]][1]===CUR&&G[r[0]][2]===2&&!seen.has(r[0])){seen.add(r[0]);r[5]?w++:l++}});return recC[t]=w+'-'+l}
function roster(t){const out=[];P.forEach((p,i)=>{if(p[1]!==t)return;const c=byP.get(i).filter(r=>G[r[0]][1]===CUR);if(c.length)out.push({i,mpg:avg(c.map(r=>r[8])),c})});return out.sort((a,b)=>b.mpg-a.mpg)}
function renderSlate(v){
  const dates=[...new Set(D.sched.map(s=>s[0]))];if(!st.date)st.date=dates[0];
  v.append(el(`<div><h1>Games</h1><div class="muted">Pick a game to compare both rosters, or search any player.</div></div>`));
  const ch=el('<div class="chips" role="group" aria-label="Game date"></div>');
  dates.forEach(d=>{const b=el(`<button class="chip" aria-pressed="${d===st.date}">${dl(d)}</button>`);b.onclick=()=>{st.date=d;render()};ch.append(b)});v.append(ch);
  const grid=el('<div class="games"></div>');
  D.sched.filter(s=>s[0]===st.date).forEach(s=>{const [d,time,a,h]=s;
    const faces=t=>roster(t).slice(0,5).map(x=>avatar(x.i,30,false)).join('');
    const b=el(`<button class="game"><div class="muted" style="font-size:13px">${esc(time)} ET</div>
      <div class="tm">${logo(a,28)}${esc(tN(a))}<small>${record(a)}</small></div><div class="faces">${faces(a)}</div>
      <div class="tm">${logo(h,28)}${esc(tN(h))}<small>${record(h)}</small></div><div class="faces">${faces(h)}</div></button>`);
    b.onclick=()=>{st.game=s;render();window.scrollTo(0,0)};grid.append(b)});
  v.append(grid);
}
function renderMatchup(v){
  const [d,time,a,h]=st.game;
  const back=el('<button class="chip" style="margin-top:12px">← All games</button>');back.onclick=()=>{st.game=null;render()};v.append(back);
  v.append(el(`<div><h1>${esc(tS(a))} at ${esc(tS(h))}</h1><div class="muted">${dl(d)}, ${esc(time)} ET. Vs opp covers this season and last. R = opponent rank allowed to that position (1 = softest).</div></div>`));
  const ch=el('<div class="chips" role="group" aria-label="Stat"></div>');
  SK.forEach(k=>{const b=el(`<button class="chip" aria-pressed="${k===st.mStat}">${k}</button>`);b.onclick=()=>{st.mStat=k;render()};ch.append(b)});v.append(ch);
  const g=el('<div class="mgrid"></div>');[[a,h],[h,a]].forEach(([t,o])=>g.append(teamTable(t,o)));v.append(g);
}
function teamTable(t,o){
  const k=st.mStat,f=sf(k);
  const box=el(`<section class="panel"><div class="mhead">${logo(t,34)}<h2>${esc(tN(t))}</h2><span class="muted" style="margin-left:auto">vs ${esc(tA(o))}</span></div><div class="tw"><table><thead><tr><th class="l">Player</th><th>MIN</th><th>Season</th><th>L5</th><th>Vs ${esc(tA(o))}</th><th>R</th></tr></thead><tbody></tbody></table></div></section>`);
  const tb=box.querySelector('tbody');
  roster(t).forEach(x=>{const all=byP.get(x.i),vs=all.filter(r=>r[3]===o);const sa=avg(x.c.map(f)),l5=avg(x.c.slice(-5).map(f)),va=avg(vs.map(f));
    const rk=RANK[CUR][posG(P[x.i][2])][k][o];
    const ps=pstat(x.i);
    const tr=el(`<tr class="${ps?'out':''}"><td class="l"><button class="link">${avatar(x.i,34,false)}<span class="nm">${esc(P[x.i][0])}</span><span class="pill">${esc(P[x.i][2]||'–')}</span>${ps?`<span class="pill red" title="${esc(ps.label)}">${ps.short}</span>`:''}</button></td><td>${fmt(x.mpg)}</td><td>${fmt(sa)}</td><td class="${cmp(l5,sa)}">${fmt(l5)}</td><td class="${cmp(va,sa)}">${fmt(va)} <span class="muted">(${vs.length})</span></td><td style="font-family:var(--mono);font-weight:700;color:${rk?rkCls(rk):'var(--muted)'}">${rk||'–'}</td></tr>`);
    tr.querySelector('button').onclick=()=>openPlayer(x.i,{stat:k});tb.append(tr)});
  return box;
}
const cmp=(v,b)=>v==null||b==null?'':v>=b*1.1?'ov':v<=b*.9?'un':'';

/* ---- player ---- */
function baseGames(i){return byP.get(i).filter(r=>(st.venue==='all'||(st.venue==='home')==!!r[4])&&(st.opp==='all'||r[3]==st.opp))}
function sampleGames(i){
  const g=baseGames(i),s=st.sample,ng=nextGame(P[i][1]);
  if(s==='S'+CUR)return g.filter(r=>G[r[0]][1]===CUR);
  if(s==='S'+PREV)return g.filter(r=>G[r[0]][1]===PREV);
  if(s==='H2H')return ng?g.filter(r=>r[3]===ng.opp):[];
  return g.slice(-(+s.slice(1)));
}
function renderPlayer(v){
  const i=st.pid,p=P[i],k=st.stat,f=sf(k),L=lineFor(i,k),ng=nextGame(p[1]);
  const ps=pstat(i);
  if(ps)v.append(el(`<div class="alert">${ps.short} · ${esc(ps.label)} · missed ${ps.n===1?'the last game':'the last '+ps.n+' games'}</div>`));
  const grid=el('<div class="grid2"></div>');v.append(grid);
  const left=el('<section class="panel"></section>');grid.append(left);
  // prop tabs
  const tabs=el('<div class="ptabs" role="tablist"></div>');
  const l10=baseGames(i).slice(-10);
  SK.forEach(key=>{const h=hr(l10.map(sf(key)),lineFor(i,key));
    const b=el(`<button role="tab" aria-selected="${key===k}">${key}<span class="badge ${h==null?'':h>=.6?'':h>=.4?'mid':'lo'}">${h==null?'–':Math.round(h*100)+'%'}</span></button>`);
    b.onclick=()=>{st.stat=key;save();render()};tabs.append(b)});
  left.append(tabs);
  requestAnimationFrame(()=>{const s=tabs.querySelector('[aria-selected="true"]');if(s)s.scrollIntoView({block:'nearest',inline:'nearest'})});
  // prop bar
  const pb=el(`<div class="propbar"><button class="ou ${st.under?'under':''}" title="Switch over/under">${st.under?'UNDER':'OVER'}</button><div class="ptitle">${L} ${esc(sname(k))}</div>
    <div class="linebox"><span>LINE</span><button aria-label="Lower line">−</button><input aria-label="Line" inputmode="decimal" value="${L}"><button aria-label="Raise line">+</button></div></div>`);
  const [minus,inp,plus]=pb.querySelectorAll('.linebox button, .linebox input');
  const setL=x=>{st.lines[i+'|'+k]=Math.max(0,+x.toFixed(1));render()};
  pb.querySelector('.ou').onclick=()=>{st.under=!st.under;render()};
  minus.onclick=()=>setL(L-1);plus.onclick=()=>setL(L+1);inp.oninput=()=>{let v=inp.value.replace(/[^0-9.]/g,'');const dp=v.indexOf('.');if(dp>-1)v=v.slice(0,dp+1)+v.slice(dp+1).replace(/\./g,'');if(v!==inp.value)inp.value=v};inp.onkeydown=e=>{if(e.key==='Enter')inp.blur()};inp.onchange=()=>{const x=parseFloat(inp.value);if(!isNaN(x))setL(x);else inp.value=L};
  left.append(pb);
  if(ng)left.append(el(`<div class="ctx"><div style="display:flex;align-items:center;gap:6px">${ng.home?'Home':'Away'} vs ${logo(ng.opp,20)} ${esc(tA(ng.opp))}</div><div class="m">${dl(ng.date)}, ${esc(ng.time)} ET</div><div class="m">Opp rank vs ${posG(p[2])}: <b style="color:${rkCls(RANK[CUR][posG(p[2])][k][ng.opp])}">${RANK[CUR][posG(p[2])][k][ng.opp]||'–'}/${NT}</b></div></div>`));
  // chart
  const g=sampleGames(i),chart=el('<div class="chart"></div>');left.append(chart);
  // tiles
  const base=baseGames(i),cur=base.filter(r=>G[r[0]][1]===CUR),prev=base.filter(r=>G[r[0]][1]===PREV),h2h=ng?base.filter(r=>r[3]===ng.opp):[];
  const tdef=[['S'+PREV,"'25-'26",prev],['S'+CUR,"'26-'27",cur],['H2H','H2H',h2h],['L5','L5',base.slice(-5)],['L10','L10',base.slice(-10)],['L20','L20',base.slice(-20)]];
  const tiles=el('<div class="tiles"></div>');
  tdef.forEach(([key,lab,arr])=>{const vals=arr.map(f),n=vals.filter(x=>hit(x,L)).length,h=hr(vals,L);
    const b=el(`<button class="tile" aria-pressed="${st.sample===key}"><div class="h">${lab}</div><div class="b ${cls(h)}">${vals.length?`${n}/${vals.length}<br>${Math.round(h*100)}%`:'N/A<br>&nbsp;'}</div></button>`);
    b.onclick=()=>{st.sample=key;render()};tiles.append(b)});
  left.append(tiles);
  // filters
  const opts=T.map((t,x)=>x).filter(x=>x!==p[1]).sort((a,b)=>tN(a)<tN(b)?-1:1).map(x=>`<option value="${x}">${esc(tN(x))} (${byP.get(i).filter(r=>r[3]===x).length})</option>`).join('');
  const fl=el(`<div class="filters"><span class="fl">Filters</span><select aria-label="Home or away"><option value="all">Home and away</option><option value="home">Home</option><option value="away">Away</option></select><select aria-label="Opponent"><option value="all">All opponents</option>${opts}</select></div>`);
  const [sv,so]=fl.querySelectorAll('select');sv.value=st.venue;so.value=st.opp;
  sv.onchange=e=>{st.venue=e.target.value;render()};so.onchange=e=>{st.opp=e.target.value;render()};
  left.append(fl);
  requestAnimationFrame(()=>drawChart(chart,g,f,L,posG(p[2]),k));

  // right panel
  const right=el('<section class="panel"></section>');grid.append(right);
  const rt=el('<div class="rtabs" role="tablist"></div>');
  [['opp','Opponent'],['split','Vs teams'],['log','Game log']].forEach(([key,lab])=>{const b=el(`<button role="tab" aria-selected="${st.rtab===key}">${lab}</button>`);b.onclick=()=>{st.rtab=key;render()};rt.append(b)});
  right.append(rt);
  const body=el('<div class="rbody"></div>');right.append(body);
  if(st.rtab==='opp')oppTab(body,i,ng);else if(st.rtab==='split')splitTab(body,i,f,L);else logTab(body,g);
}
function drawChart(box,g,f,L,pg,k){
  if(!g.length){box.innerHTML='<div class="empty">No games match these filters.</div>';return}
  const W=Math.max(320,box.clientWidth-16),H=340,lp=34,rp=8,top=34,bot=50;
  const vals=g.map(f),mx=Math.max(L,...vals,1),step=mx<=5?1:mx<=12?2.5:mx<=25?5:mx<=60?10:20,ymax=Math.ceil(mx*1.12/step)*step;
  const n=g.length,slot=(W-lp-rp)/n,bw=Math.max(3,Math.min(56,slot*.72));
  const y=v=>top+(1-v/ymax)*(H-top-bot);
  const a=avg(vals);
  let s=`<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(k)} by game">`;
  for(let t=0;t<=ymax+1e-9;t+=step){s+=`<line x1="${lp}" x2="${W-rp}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)" stroke-width="1"/><text x="${lp-6}" y="${y(t)+4}" text-anchor="end" font-size="12" fill="var(--ink)" font-family="Barlow,sans-serif" font-weight="600">${+t.toFixed(1)}</text>`}
  const showTxt=bw>=20,showX=slot>=44;
  g.forEach((r,j)=>{const v=vals[j],x=lp+j*slot+(slot-bw)/2,gm=G[r[0]],ok=hit(v,L);
    const col=ok?'var(--overbg)':'var(--under)';
    s+=`<rect x="${x}" y="${y(v)}" width="${bw}" height="${Math.max(2,y(0)-y(v))}" fill="${col}"><title>${md(gm[0])} ${r[4]?'vs':'@'} ${tA(r[3])}: ${v} ${k} in ${r[8]} min</title></rect>`;
    if(showTxt)s+=`<text x="${x+bw/2}" y="${Math.min(y(v)+18,y(0)-4)}" text-anchor="middle" font-size="${bw>34?15:12}" font-weight="700" fill="#fff" font-family="Barlow,sans-serif">${v}</text>`;
    const rk=gm[2]===2&&RANK[gm[1]]&&RANK[gm[1]][pg][k]?RANK[gm[1]][pg][k][r[3]]:null;
    if(rk&&slot>=24)s+=`<text x="${x+bw/2}" y="${y(v)-7}" text-anchor="middle" font-size="${slot>=40?13:10}" font-weight="700" fill="${rkCls(rk)}" font-family="JetBrains Mono,monospace">${slot>=40?'R:':''}${rk}</text>`;
    if(showX){s+=`<text x="${x+bw/2}" y="${H-bot+18}" text-anchor="middle" font-size="12" fill="var(--ink)" font-family="Barlow,sans-serif">${r[4]?'vs':'@'} ${tA(r[3])}</text><text x="${x+bw/2}" y="${H-bot+33}" text-anchor="middle" font-size="11" fill="var(--muted)" font-family="Barlow,sans-serif">${md(gm[0])}</text>`}
    else if(slot>=18)s+=`<text x="${x+bw/2}" y="${H-bot+16}" text-anchor="middle" font-size="9" fill="var(--muted)" font-family="Barlow,sans-serif">${tA(r[3])}</text>`;
  });
  s+=`<line x1="${lp}" x2="${W-rp}" y1="${y(L)}" y2="${y(L)}" stroke="#fff" stroke-width="2"/>`;
  s+=`<line x1="${lp}" x2="${W-rp}" y1="${y(a)}" y2="${y(a)}" stroke="var(--avg)" stroke-width="2"/>`;
  const lx=lp+(W-lp-rp)/2;s+=`<rect x="${lx-40}" y="${y(a)-11}" width="80" height="22" rx="5" fill="#5B4A8F"/><text x="${lx}" y="${y(a)+5}" text-anchor="middle" font-size="13" font-weight="700" fill="#fff" font-family="Barlow,sans-serif">${fmt(a)} AVG</text>`;
  s+='</svg>';box.innerHTML=s;
}
function oppTab(body,i,ng){
  const p=P[i],k=st.stat;
  const opp=st.dOpp!=null?st.dOpp:(st.opp!=='all'?+st.opp:(ng?ng.opp:(p[1]===0?1:0)));
  const pos=st.dPos||posG(p[2]),s=st.dSeason,d=DEF[s][opp];
  if(!d){body.append(el('<div class="empty">No defensive data for this season yet.</div>'));return}
  const comp=Math.round(avg(SK.slice(0,4).map(x=>RANK[s][pos][x][opp])));
  const tier=comp<=10?'SOFT MATCHUP':comp<=20?'AVERAGE MATCHUP':'TOUGH MATCHUP';
  const opts=T.map((t,x)=>x).filter(x=>x!==p[1]).sort((a,b)=>tN(a)<tN(b)?-1:1).map(x=>`<option value="${x}" ${x===opp?'selected':''}>${esc(tN(x))}</option>`).join('');
  const hd=el(`<div class="dhead">${logo(opp,46)}<div><h2>${esc(tS(opp))} defense allowed</h2><span class="mtag">${tier}</span><div class="comp">Composite ${comp}/${NT} <span>· ${esc(POSN[pos])} · ${SEASONS[s]} regular season</span></div></div>
    <div style="margin-left:auto;display:flex;gap:6px;flex-wrap:wrap"><select aria-label="Opponent">${opts}</select><select aria-label="Season"><option value="${CUR}">${SEASONS[CUR]}</option><option value="${PREV}">${SEASONS[PREV]}</option></select></div></div>`);
  const [so,ss]=hd.querySelectorAll('select');ss.value=s;so.onchange=e=>{st.dOpp=+e.target.value;render()};ss.onchange=e=>{st.dSeason=+e.target.value;render()};
  body.append(hd);
  const cr=el('<div class="chiprow"><span class="fl">Position</span></div>');
  ['A','G','F','C'].forEach(x=>{const b=el(`<button class="chip" aria-pressed="${x===pos}">${x==='A'?'All':x}</button>`);b.onclick=()=>{st.dPos=x;render()};cr.append(b)});
  body.append(cr);
  const core=['PTS','REB','AST','3PM','STL','BLK'];
  const rks=core.map(x=>[x,RANK[s][pos][x][opp]]).sort((a,b)=>a[1]-b[1]);
  const weak=rks[0],strong=rks[rks.length-1],me=RANK[s][pos][k][opp];
  const card=(c,lab,key,r)=>`<div class="card ${c}"><div class="k">${lab}</div><div class="v">${esc(sname(key))} <em>${fmt(DEF[s][opp][pos][key])}</em></div><div class="s">Rank ${r} of ${NT} in what they allow to ${esc(POSN[pos].toLowerCase())}</div></div>`;
  body.append(el(`<div class="cards">${card('','WEAKEST SPOT',weak[0],weak[1])}${card('str','STRONGEST SPOT',strong[0],strong[1])}${card('','THIS PROP',k,me)}</div>`));
  body.append(el(`<div class="legend"><span style="flex:1 1 220px">Bars read from the offense's side: right of centre means this defense gives up more than average.</span><span><i class="dot" style="background:var(--over)"></i>Softest, rank 1–10</span><span><i class="dot" style="background:var(--amber)"></i>Middle 10</span><span><i class="dot" style="background:var(--under)"></i>Toughest, rank 21–30</span></div>`));
  const tbl=el(`<div class="dtable"><div class="dth"><span>STAT</span><span style="text-align:right">PER GAME</span><span style="display:flex;justify-content:space-between"><span>◀ TOUGHER</span><span>SOFTER ▶</span></span><span style="text-align:right">LEAGUE</span></div></div>`);
  SK.forEach(x=>{const val=DEF[s][opp][pos][x],lg=LG[s][pos][x],r=RANK[s][pos][x][opp];
    const dev=Math.max(-1,Math.min(1,(val-lg)/(lg||1)/0.35)),w=Math.abs(dev)*50;
    const bar=dev>=0?`left:50%;width:${w}%`:`left:${50-w}%;width:${w}%`;
    tbl.append(el(`<div class="dtr ${x===k?'sel':''}"><span class="n">${x}</span><span class="val">${fmt(val)}</span><span class="track"><i style="${bar};background:${rkCls(r)}"></i></span><span class="rk">Rank<b style="color:${rkCls(r)}">${r}</b>avg ${fmt(lg)}</span></div>`))});
  body.append(tbl);
}
function splitTab(body,i,f,L){
  const all=byP.get(i),m=new Map();
  all.forEach(r=>{const o=r[3];if(!m.has(o))m.set(o,{o,c:[],p:[]});(G[r[0]][1]===CUR?m.get(o).c:m.get(o).p).push(f(r))});
  const rows=[...m.values()].map(x=>{const v=[...x.p,...x.c];return{...x,v,a:avg(v),h:hr(v,L)}}).sort((a,b)=>b.a-a.a);
  const box=el(`<div><div class="muted" style="margin-bottom:8px">${esc(st.stat)} vs every opponent, both seasons. ${st.under?'Under':'Over'} ${L}. Tap a team to filter the graph.</div><div class="tw"><table><thead><tr><th class="l">Opponent</th><th>GP</th><th>Avg</th><th>${SEASONS[CUR]}</th><th>${SEASONS[PREV]}</th><th>Hit</th><th class="l">Games</th></tr></thead><tbody></tbody></table></div></div>`);
  const tb=box.querySelector('tbody');
  rows.forEach(x=>{const tr=el(`<tr><td class="l"><button class="link">${logo(x.o,22)}<span class="nm">${esc(tS(x.o))}</span></button></td><td>${x.v.length}</td><td><b>${fmt(x.a)}</b></td><td>${fmt(avg(x.c))}</td><td>${fmt(avg(x.p))}</td><td class="${x.h>=.6?'ov':x.h<.4?'un':''}">${Math.round(x.h*100)}%</td><td class="l">${[...x.p,...x.c].map(v=>`<span class="${hit(v,L)?'ov':'un'}">${v}</span>`).join(' ')}</td></tr>`);
    tr.querySelector('button').onclick=()=>{st.opp=String(x.o);st.sample='L20';render()};tb.append(tr)});
  body.append(box);
}
function logTab(body,g){
  const box=el(`<div><div class="muted" style="margin-bottom:8px">${g.length} games in the current graph, newest first.</div><div class="tw"><table><thead><tr><th class="l">Date</th><th class="l">Opp</th><th class="l">Result</th><th>MIN</th><th>PTS</th><th>REB</th><th>AST</th><th>3PM</th><th>STL</th><th>BLK</th><th>FG</th><th>FT</th><th>TOV</th><th>+/-</th></tr></thead><tbody></tbody></table></div></div>`);
  const tb=box.querySelector('tbody');
  const items=g.map(r=>({d:G[r[0]][0],r}));
  if(g.length){const lo=G[g[0][0]][0],pid=g[0][1];(DNP.get(pid)||[]).forEach(x=>{const d0=G[x[0]][0];if(d0>=lo&&(st.venue==='all'||(st.venue==='home')==!!x[3])&&(st.opp==='all'||x[2]==st.opp))items.push({d:d0,x})})}
  items.sort((a,b)=>a.d<b.d?1:-1);
  items.forEach(it=>{if(it.x){const x=it.x;tb.append(el(`<tr class="dnprow"><td class="l">${md(it.d)}</td><td class="l">${x[3]?'vs':'@'} ${tA(x[2])}</td><td class="l" colspan="12">DNP · ${esc(dnpLabel(x[4]))}</td></tr>`));return}
    const r=it.r;const gm=G[r[0]],tag=gm[2]===3?'<span class="pill">PO</span>':gm[2]===5?'<span class="pill">PI</span>':'';
    tb.append(el(`<tr><td class="l">${md(gm[0])}</td><td class="l">${r[4]?'vs':'@'} ${tA(r[3])}${tag}</td><td class="l ${r[5]?'ov':'un'}">${r[5]?'W':'L'} ${r[6]}-${r[7]}</td><td>${r[8]}</td><td>${r[9]}</td><td>${r[10]}</td><td>${r[11]}</td><td>${r[15]}-${r[16]}</td><td>${r[12]}</td><td>${r[13]}</td><td>${r[17]}-${r[18]}</td><td>${r[19]}-${r[20]}</td><td>${r[14]}</td><td>${r[21]>0?'+':''}${r[21]}</td></tr>`))});
  body.append(box);
}
let rz;addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(()=>{if(st.view==='player')render()},200)});
render();
</script>
